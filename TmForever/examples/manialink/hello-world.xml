<?xml version="1.0" encoding="UTF-8"?>
<!--
  A translated browser page.
  posn is "x y z": x grows to the right, y up, and a larger z is nearer.
  Colors have 3 or 4 hex digits. action="0" closes the browser.
-->
<manialink xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="../../manialink.xsd">
  <dico>
    <language id="en">
      <hello>Hello, TrackMania!</hello>
      <close>Close</close>
    </language>
    <language id="de">
      <hello>Hallo, TrackMania!</hello>
      <close>Schließen</close>
    </language>
  </dico>

  <frame posn="0 0 0">
    <quad posn="0 0 0" sizen="60 30" halign="center" valign="center" bgcolor="123E"/>
    <label posn="0 5 1" sizen="56 6" halign="center" valign="center"
           textsize="5" textcolor="FFF" textid="hello"/>
    <label posn="0 -7 1" sizen="20 5" halign="center" valign="center"
           textsize="2" focusareacolor1="06C" focusareacolor2="09F" action="0" textid="close"/>
  </frame>
</manialink>
