<?xml version="1.0" encoding="UTF-8"?>
<!--
  Play a map.
  A local map with this uid is used if there is one, otherwise it is downloaded from url.
  noconfirmation only hides the final "ManiaCode complete" message.
-->
<maniacode noconfirmation="1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="../../maniacode.xsd">
  <play_map>
    <name>Example Map</name>
    <uid>ExampleMapUid00000000000000</uid>
    <url>https://example.com/maps/example.Map.Gbx</url>
  </play_map>
</maniacode>
